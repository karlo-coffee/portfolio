@{
    ViewBag.Title = "HCI Project - Macadat241678";
}

<style>
    /* CYBER HUD GRID OVERLAY */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: -1;
    }

    body {
        background-color: #2c3e50 !important; /* Stone Gray Base */
        margin: 0;
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .project-wrapper {
        display: flex;
        min-height: 85vh;
        margin: 30px auto;
        width: 95%;
        background: rgba(13, 27, 42, 0.95) !important;
        border-radius: 30px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.6);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* SIDEBAR - Requested Gradient */
    .sidebar {
        flex: 0 0 220px;
        background: linear-gradient(to right, #1F1C2C, #928DAB);
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-right: 1px solid rgba(255,255,255,0.1);
    }

    .profile-roll {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 3px solid #fdbb2d;
        object-fit: cover;
        animation: rollIn 1.0s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @@keyframes rollIn {
        0% {
            width: 180px;
            height: 180px;
            transform: translate(80px, 180px) rotate(-180deg);
            opacity: 0;
        }

        100% {
            width: 60px;
            height: 60px;
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }
    }

    /* CONTENT AREA */
    .content-section {
        flex: 1;
        padding: 50px;
        color: white;
        background: #0d1b2a;
    }

    .info-box {
        background: rgba(255, 255, 255, 0.03);
        padding: 30px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        margin-bottom: 30px;
    }

    .section-title {
        color: #fdbb2d;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 800;
        margin-bottom: 20px;
        display: block;
    }

    /* TERMINAL STYLING */
    .terminal-window {
        background: #011627;
        border-radius: 15px;
        border: 1px solid #fdbb2d;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    }

    .terminal-header {
        background: #1a2a6c;
        padding: 12px 20px;
        font-family: 'Consolas', monospace;
        font-size: 0.75rem;
        color: #fdbb2d;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid rgba(253, 187, 45, 0.3);
    }

    .terminal-body {
        padding: 30px;
        font-family: 'Consolas', monospace;
    }

    .terminal-row {
        display: flex;
        gap: 15px;
        margin: 20px 0;
    }

    .terminal-input {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.2);
        color: #fdbb2d;
        padding: 12px;
        border-radius: 8px;
        flex: 1;
        outline: none;
    }

    .terminal-btn {
        background: #fdbb2d;
        color: #0d1b2a;
        border: none;
        padding: 0 25px;
        border-radius: 8px;
        font-weight: 900;
        cursor: pointer;
        transition: 0.3s;
    }

        .terminal-btn:hover {
            background: white;
            transform: translateY(-2px);
        }

    #outputDisplay {
        background: rgba(0,0,0,0.4);
        padding: 15px;
        border-radius: 8px;
        min-height: 60px;
        color: #bdc3c7;
        border-left: 4px solid #fdbb2d;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .nav-btn {
        margin-top: 25px;
        padding: 12px 20px;
        background: rgba(255,255,255,0.1);
        color: #fdbb2d;
        border-radius: 12px;
        text-decoration: none !important;
        font-weight: bold;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.1);
    }
</style>

<div class="project-wrapper">
    <aside class="sidebar">
        <img src="~/Content/Image/Portrait.kinjihakari.png" class="profile-roll" alt="Macadat" />
        <h4 style="color:white; margin-top:20px; text-align:center; font-weight: 700;">Project Specs</h4>
        <p style="color: rgba(255,255,255,0.5); font-size: 0.7rem; letter-spacing: 1px;">QUEST #01</p>

        <a href="@Url.Action("Macadat241678Portfolio", "Macadat241678Home")" class="nav-btn">BACK TO ARCHIVE</a>
    </aside>

    <main class="content-section">
        <div class="info-box">
            <h2 style="color: #fdbb2d; text-transform: uppercase; letter-spacing: 2px; margin-top:0;">HCI: Basic I/O Simulation</h2>
            <p style="color: #bdc3c7; line-height: 1.6; font-size: 0.95rem;">
                This project was created for the <strong>Human-Computer Interaction</strong> course. It demonstrates the core loop of user input and immediate system feedback, simulating a terminal handshake logic.
            </p>
        </div>

        <span class="section-title">Live Logic Test</span>

        <div class="terminal-window">
            <div class="terminal-header">
                <span>SYSTEM TERMINAL: MACADAT_241678</span>
                <span>STATUS: READY</span>
            </div>
            <div class="terminal-body">
                <p style="color: #666; margin: 0;">// Input data to verify the feedback loop handshake</p>

                <div class="terminal-row">
                    <input type="text" id="userInput" class="terminal-input" placeholder="Enter command or string..." />
                    <button onclick="runIO()" class="terminal-btn">EXECUTE</button>
                </div>

                <div id="outputDisplay">
                    > System waiting for user input...
                </div>
            </div>
        </div>

        <div class="info-box" style="margin-top: 30px; border-left: 4px solid #fdbb2d;">
            <h5 style="color: #fdbb2d; margin-top:0;">Technical Note</h5>
            <p style="color: #bdc3c7; font-size: 0.85rem; margin-bottom:0;">
                This specific iteration focuses on web feedback loops. The original compilation included various logic gates like loops and conditionals to test program efficiency.
            </p>
        </div>
    </main>
</div>

<script>
    function runIO() {
        const val = document.getElementById('userInput').value;
        const out = document.getElementById('outputDisplay');

        if (val.trim() === "") {
            out.innerHTML = "> <span style='color: #ff4d4d;'>Error:</span> Please input data to process.";
        } else {
            out.innerHTML = `> <span style='color: #fdbb2d;'>Input Received:</span> "${val}"<br>` +
                `> <span style='color: #4df3ff;'>Output:</span> Successfully processed at ${new Date().toLocaleTimeString()}.`;
        }
        document.getElementById('userInput').value = "";
    }

    // Enter Key Support
    document.getElementById("userInput").addEventListener("keypress", function (e) {
        if (e.key === "Enter") runIO();
    });
</script>