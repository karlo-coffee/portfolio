@{
    ViewBag.Title = "MacadatInfo - System Compilation";
}

<style>
    /* 3. CYBER HUD GRID OVERLAY */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 30px 30px;
        pointer-events: none;
        z-index: -1;
    }

    body {
        background-color: #2c3e50 !important; /* Stone Gray Base */
        margin: 0;
        padding: 0;
        min-height: 100vh;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* 1. NEON GLASSMORPHISM CONTAINER */
    .classy-index-container {
        min-height: 85vh;
        display: flex;
        background: rgba(13, 27, 42, 0.8) !important;
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-radius: 30px;
        overflow: hidden;
        margin: 30px auto;
        width: 95%;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 20px 50px rgba(0,0,0,0.5), inset 0 0 20px rgba(255, 255, 255, 0.05);
    }

    /* Updated Sidebar Gradient */
    .profile-section {
        background: linear-gradient( to right, #1F1C2C,#928DAB );
        color: white;
        padding: 60px 40px;
        text-align: center;
        flex: 0 0 35%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    .profile-circle {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        margin: 0 auto 20px;
        border: 4px solid #ffffff;
        object-fit: cover;
        display: block;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        transition: all 0.8s cubic-bezier(0.6, -0.28, 0.735, 0.045);
    }

        /* Exit Animation */
        .profile-circle.rolling-out {
            transform: translate(400px, 150px) rotate(360deg) scale(0.3);
            opacity: 0;
        }

    .link-frame-section {
        flex: 1;
        padding: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0d1b2a !important; /* Deep dark contrast */
    }

    /* Glass Compilation Card */
    .glass-frame {
        width: 100%;
        background: rgba(255, 255, 255, 0.03) !important;
        padding: 40px;
        border-radius: 25px;
        border: 1px solid rgba(0, 210, 255, 0.2) !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    }

    .frame-title {
        color: #ffffff;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 25px;
        letter-spacing: 3px;
        text-shadow: 0 0 10px rgba(0, 210, 255, 0.5);
    }

    /* Button Grid Styling */
    .grid-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .grid-item {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 70px;
        background: rgba(255, 255, 255, 0.07) !important;
        color: white !important;
        text-decoration: none !important;
        font-weight: 700;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        transition: all 0.3s ease !important;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

        .grid-item:hover {
            background: rgba(253, 187, 45, 0.2) !important;
            color: #fdbb2d !important;
            border: 1px solid #fdbb2d !important;
            transform: translateY(-5px);
            box-shadow: 0 0 15px rgba(253, 187, 45, 0.4);
        }

    /* Special highlight for the bottom button */
    .gallery-btn {
        grid-column: span 4;
        background: rgba(0, 210, 255, 0.1) !important;
        border-color: rgba(0, 210, 255, 0.3) !important;
    }

        .gallery-btn:hover {
            background: rgba(0, 210, 255, 0.3) !important;
            border-color: #00d2ff !important;
            color: #ffffff !important;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.5);
        }
</style>

<main class="container">
    <div class="classy-index-container">
        <div class="profile-section">
            <img id="mainProfile"
                 src="~/Content/Image/Portrait.kinjihakari.png"
                 class="profile-circle"
                 alt="Macadat" />

            <h1 style="font-weight: 800; margin-bottom: 5px;">Macadat, Karlito R.</h1>
            <p style="opacity: 0.8; font-style: italic;">"Know more about me"</p>
        </div>

        <div class="link-frame-section">
            <div class="glass-frame">
                <h3 class="frame-title">System Compilation</h3>

                <div class="grid-container">
                    @{
                        // List without "Index" to avoid redundancy
                        var pages = new[] {
                            "About", "Resume", "Skills", "Portfolio",
                            "Project1", "Project2", "Services", "Contact"
                        };
                    }

                    @foreach (var p in pages)
                    {
                        <a href="javascript:void(0);"
                           onclick="animateAndNavigate('@Url.Action("Macadat241678" + p, "Macadat241678Home")')"
                           class="grid-item">
                            @p
                        </a>
                    }

                    @* Full-width Gallery button for balance *@
                    <a href="javascript:void(0);"
                       onclick="animateAndNavigate('@Url.Action("Macadat241678Gallery", "Macadat241678Home")')"
                       class="grid-item gallery-btn">
                        Gallery
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    function animateAndNavigate(targetUrl) {
        const profile = document.getElementById('mainProfile');
        if (profile) {
            profile.classList.add('rolling-out');
        }

        setTimeout(function () {
            window.location.href = targetUrl;
        }, 800);
    }
</script>