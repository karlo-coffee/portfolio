@{
    ViewBag.Title = "Resume - Macadat241678";
}

<style>
    /* CYBER HUD GRID OVERLAY */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 30px 30px;
        pointer-events: none;
        z-index: -1;
    }

    body {
        background-color: #2c3e50 !important; /* Stone Gray Base */
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
    }

    .about-wrapper {
        display: flex;
        min-height: 85vh;
        margin: 30px auto;
        width: 95%;
        background: rgba(13, 27, 42, 0.8) !important;
        border-radius: 30px;
        position: relative;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: hidden;
    }

    /* SIDEBAR - Vibrant Sunset-to-Cyan Gradient */
    .sidebar {
        flex: 0 0 240px;
        background: linear-gradient( to right, #1F1C2C,#928DAB );
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* PROFILE IMAGE ANIMATION */
    .profile-roll {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 4px solid #ffffff;
        object-fit: cover;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        animation: rollIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

        .profile-roll.exit-active {
            animation: rollOut 0.7s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards !important;
        }

    @@keyframes rollIn {
        0% {
            width: 180px;
            height: 180px;
            transform: translate(350px, 180px) rotate(-360deg);
            opacity: 0;
        }

        100% {
            width: 80px;
            height: 80px;
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }
    }

    @@keyframes rollOut {
        0% {
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }

        100% {
            transform: translate(350px, 180px) rotate(360deg);
            opacity: 0;
            width: 180px;
            height: 180px;
        }
    }

    /* CONTENT STYLING */
    .content-section {
        flex: 1;
        padding: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0d1b2a !important;
    }

    .glass-module {
        width: 100%;
        max-width: 950px;
        background: rgba(255, 255, 255, 0.03) !important;
        backdrop-filter: blur(20px);
        border-radius: 25px;
        padding: 50px;
        border: 1px solid rgba(0, 210, 255, 0.2) !important;
        color: white;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    }

    .resume-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 60px;
    }

    .resume-header {
        border-bottom: 2px solid #f9d423;
        padding-bottom: 10px;
        margin-bottom: 25px;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: #f9d423;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .project-item {
        margin-bottom: 25px;
        padding-left: 15px;
    }

    .skill-tag {
        display: inline-block;
        background: rgba(0, 210, 255, 0.1);
        padding: 6px 15px;
        border-radius: 50px;
        margin: 5px;
        font-size: 0.75rem;
        font-weight: 700;
        border: 1px solid rgba(0, 210, 255, 0.3);
        color: #00d2ff;
        text-transform: uppercase;
    }

    .nav-btn {
        margin-top: 30px;
        padding: 12px 25px;
        background: rgba(0, 0, 0, 0.4);
        color: white;
        text-decoration: none !important;
        border-radius: 50px;
        font-weight: bold;
        transition: 0.3s;
        border: 1px solid rgba(255,255,255,0.2);
        cursor: pointer;
    }

        .nav-btn:hover {
            background: white;
            color: black;
            transform: scale(1.05);
        }

    .sub-text {
        font-size: 0.9rem;
        color: #bdc3c7;
        line-height: 1.6;
    }
</style>

<div class="about-wrapper">
    <aside class="sidebar">
        <img id="profileImage"
             src="~/Content/Image/Portrait.kinjihakari.png"
             class="profile-roll"
             alt="Macadat" />

        <h4 style="color:white; margin-top:20px; text-align:center; font-weight: 800;">Macadat, Karlito R.</h4>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.75rem; letter-spacing: 2px;">SBIT-2D</p>

        <a href="javascript:void(0);" onclick="goBack()" class="nav-btn">BACK TO MENU</a>
    </aside>

    <main class="content-section">
        <div id="contentCard" class="glass-module">
            <div class="resume-grid">

                <!-- Left Column -->
                <div>
                    <h3 class="resume-header">Core Stats</h3>
                    <div class="project-item" style="border-left: 4px solid #f9d423;">
                        <p>
                            <strong>Education</strong><br>
                            <span class="sub-text">
                                Quezon City University (QCU)<br>
                                BS Information Technology
                            </span>
                        </p>
                    </div>

                    <h3 class="resume-header" style="margin-top:40px;">Guilds</h3>
                    <div class="project-item" style="border-left: 4px solid #ff4e50;">
                        <p>
                            <strong>Kyusi Esports Community</strong><br>
                            <span class="sub-text">Active Member</span>
                        </p>
                    </div>

                    <h3 class="resume-header" style="margin-top:40px;">Skill Tree</h3>
                    <div class="skill-tag">ASP.NET MVC 5</div>
                    <div class="skill-tag">C# Logic</div>
                    <div class="skill-tag">Razor Pages</div>
                    <div class="skill-tag">Bootstrap 5</div>
                </div>

                <!-- Right Column -->
                <div>
                    <h3 class="resume-header">Quest History</h3> 
                    <div class="project-item" style="border-left: 1px solid rgba(255,255,255,0.1);">
                        <strong style="color:#00d2ff;">OLYMPIA GYM</strong>
                        <p class="sub-text">Membership system featuring registration, goals, and payment simulations.</p>
                    </div>
                    <div class="project-item" style="border-left: 1px solid rgba(255,255,255,0.1);">
                        <strong style="color:#00d2ff;">HERO REGISTRY</strong>
                        <p class="sub-text">Admin system for managing a searchable archive of hero profiles.</p>
                    </div>
                    <div class="project-item" style="border-left: 1px solid rgba(255,255,255,0.1);">
                        <strong style="color:#00d2ff;">PROG COMPILATION</strong>
                        <p class="sub-text">A web collection of basic I/O, variables, and logic samples.</p>
                    </div>
                </div>

            </div>
        </div>
    </main>
</div>

<script>
    function goBack() {
        document.getElementById('profileImage').classList.add('exit-active');

        setTimeout(function() {
            window.location.href = '@Url.Action("Macadat241678Index", "Macadat241678Home")';
        }, 700);
    }
</script>