@{
    ViewBag.Title = "Project 2: Olympia Gym - Macadat241678";
}

<style>
    /* CYBER HUD GRID OVERLAY - Consistent with Portfolio */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: -1;
    }

    body {
        background-color: #2c3e50 !important; /* Stone Gray Base */
        margin: 0;
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .project-wrapper {
        display: flex;
        min-height: 85vh;
        margin: 30px auto;
        width: 95%;
        background: rgba(13, 27, 42, 0.95) !important;
        border-radius: 30px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.6);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* SIDEBAR - Purple-Grey Gradient */
    .sidebar {
        flex: 0 0 220px;
        background: linear-gradient(to right, #1F1C2C, #928DAB);
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-right: 1px solid rgba(255,255,255,0.1);
    }

    .profile-roll {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 3px solid #fdbb2d;
        object-fit: cover;
        animation: rollIn 1.0s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @@keyframes rollIn {
        0% {
            width: 180px;
            height: 180px;
            transform: translate(80px, 180px) rotate(-180deg);
            opacity: 0;
        }

        100% {
            width: 60px;
            height: 60px;
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }
    }

    /* CONTENT AREA */
    .content-section {
        flex: 1;
        padding: 50px;
        color: white;
        background: #0d1b2a;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        padding: 30px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        margin-bottom: 30px;
    }

    /* TECH PILLS - Deep Red/Stone Theme */
    .tech-pill {
        display: inline-block;
        background: rgba(178, 31, 31, 0.15);
        color: #fff;
        padding: 6px 16px;
        border-radius: 20px;
        margin-right: 10px;
        font-size: 0.75rem;
        border: 1px solid #b21f1f;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    /* WORKFLOW GRID */
    .workflow-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .step-box {
        background: rgba(253, 187, 45, 0.03);
        padding: 25px 15px;
        border-radius: 15px;
        border: 1px dashed rgba(253, 187, 45, 0.4);
        text-align: center;
        transition: 0.3s;
    }

        .step-box:hover {
            background: rgba(253, 187, 45, 0.07);
            border-style: solid;
            transform: translateY(-3px);
        }

        .step-box h5 {
            color: white;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            font-size: 0.9rem;
        }

        .step-box p {
            font-size: 0.8rem;
            color: #bdc3c7;
            line-height: 1.4;
            margin: 0;
        }

    .nav-btn {
        margin-top: 25px;
        padding: 12px 20px;
        background: rgba(255,255,255,0.1);
        color: #fdbb2d;
        border-radius: 12px;
        text-decoration: none !important;
        font-weight: bold;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.1);
        cursor: pointer;
    }

    .features-list {
        list-style: none;
        padding-left: 0;
        font-size: 0.9rem;
        color: #bdc3c7;
    }

        .features-list li {
            margin-bottom: 10px;
            position: relative;
            padding-left: 20px;
        }

            .features-list li::before {
                content: "▪";
                color: #b21f1f;
                position: absolute;
                left: 0;
            }
</style>

<div class="project-wrapper">
    <aside class="sidebar">
        <img src="~/Content/Image/Portrait.kinjihakari.png" class="profile-roll" alt="Macadat" />
        <h4 style="color:white; margin-top:20px; text-align:center; font-weight: 700;">Project Focus</h4>
        <p style="color: rgba(255,255,255,0.5); font-size: 0.7rem; letter-spacing: 1px;">QUEST #02</p>

        <a href="@Url.Action("Macadat241678Portfolio", "Macadat241678Home")" class="nav-btn">BACK TO ARCHIVE</a>
    </aside>

    <main class="content-section">
        <div class="glass-card">
            <h2 style="color: #fdbb2d; text-transform: uppercase; letter-spacing: 2px; margin-top:0;">Olympia Gym System</h2>
            <p style="color: #bdc3c7; line-height: 1.6; font-size: 0.95rem;">
                A comprehensive membership management system designed to streamline the gym experience.
                This project focuses on handling user registrations, fitness goal tracking, and simulating secure payment transactions.
            </p>

            <div style="margin-top: 20px;">
                <span class="tech-pill">ASP.NET MVC</span>
                <span class="tech-pill">Bootstrap 5</span>
                <span class="tech-pill">JavaScript</span>
                <span class="tech-pill">C# Logic</span>
            </div>
        </div>

        <h4 style="color: #fdbb2d; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px;">System Workflow</h4>

        <div class="workflow-grid">
            <div class="step-box">
                <h5>Registration</h5>
                <p>Captures user credentials, contact details, and workout intent.</p>
            </div>
            <div class="step-box">
                <h5>Plan Selection</h5>
                <p>Dynamic selection of membership tiers with payment simulation.</p>
            </div>
            <div class="step-box">
                <h5>Dashboard</h5>
                <p>Interactive profile display showing personal stats and membership status.</p>
            </div>
        </div>

        <div class="glass-card" style="margin-top: 30px; border-left: 4px solid #b21f1f;">
            <h5 style="color: #fdbb2d; margin-top:0; text-transform: uppercase;">Key Features Implemented</h5>
            <ul class="features-list">
                <li><strong>Interactive UI:</strong> Built with Bootstrap 5 for full responsiveness.</li>
                <li><strong>Data Handling:</strong> Used Razor Pages and C# to manage state between forms.</li>
                <li><strong>Validation:</strong> Client and server-side checks for membership security.</li>
            </ul>
        </div>
    </main>
</div>