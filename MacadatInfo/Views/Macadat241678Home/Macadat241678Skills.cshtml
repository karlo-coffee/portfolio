@{
    ViewBag.Title = "Skills - Macadat241678";
}

<style>
    /* CYBER HUD GRID OVERLAY */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 30px 30px;
        pointer-events: none;
        z-index: -1;
    }

    body {
        background-color: #2c3e50 !important; /* Stone Gray Base */
        margin: 0;
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .about-wrapper {
        display: flex;
        min-height: 85vh;
        margin: 30px auto;
        width: 95%;
        background: rgba(13, 27, 42, 0.9) !important;
        border-radius: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* SIDEBAR - Requested Gradient */
    .sidebar {
        flex: 0 0 220px;
        background: linear-gradient(to right, #1F1C2C, #928DAB);
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* PROFILE IMAGE ANIMATIONS */
    .profile-roll {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 3px solid #fdbb2d;
        object-fit: cover;
        animation: rollIn 1.0s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

        .profile-roll.rolling-out {
            animation: rollOut 0.8s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards !important;
        }

    @@keyframes rollIn {
        0% {
            width: 180px;
            height: 180px;
            transform: translate(80px, 180px) rotate(-180deg);
            opacity: 0;
        }

        100% {
            width: 60px;
            height: 60px;
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }
    }

    @@keyframes rollOut {
        0% {
            width: 60px;
            height: 60px;
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }

        100% {
            width: 180px;
            height: 180px;
            transform: translate(80px, 180px) rotate(180deg);
            opacity: 0;
        }
    }

    /* SKILL CONTENT STYLING */
    .content-section {
        flex: 1;
        padding: 50px;
        color: white;
        background: #0d1b2a;
    }

    .skill-category {
        margin-bottom: 25px;
        background: rgba(255, 255, 255, 0.03);
        padding: 25px;
        border-radius: 15px;
        border-left: 4px solid #fdbb2d; /* Gold for Architect */
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .skill-header {
        color: #fdbb2d;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 20px;
        font-weight: 800;
        font-size: 0.9rem;
    }

    /* Grid layout matching image_afc6c0.png */
    .skill-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .skill-box {
        background: rgba(255, 255, 255, 0.05);
        padding: 20px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .skill-box:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-8px);
            border-color: #fdbb2d;
            box-shadow: 0 0 20px rgba(253, 187, 45, 0.2);
        }

        .skill-box h5 {
            margin: 0 0 10px 0;
            font-weight: 700;
            color: #fff;
        }

        .skill-box p {
            margin: 0;
            font-size: 0.85rem;
            color: #bdc3c7;
            line-height: 1.5;
        }

    .nav-btn {
        margin-top: 20px;
        padding: 10px 20px;
        background: rgba(255,255,255,0.1);
        color: #fdbb2d;
        border-radius: 12px;
        text-decoration: none !important;
        font-weight: bold;
        display: inline-block;
        border: 1px solid rgba(255,255,255,0.1);
        cursor: pointer;
        transition: 0.3s;
    }

        .nav-btn:hover {
            background: #fdbb2d;
            color: #0d1b2a;
        }
</style>

<div class="about-wrapper">
    <aside class="sidebar">
        <img id="profileImage" src="~/Content/Image/Portrait.kinjihakari.png" class="profile-roll" alt="Macadat" />
        <h4 style="color:white; margin-top:20px; text-align:center; font-weight: 700;">Macadat, Karlito R.</h4>
        <p style="color: rgba(255,255,255,0.6); font-size: 0.75rem; letter-spacing: 1px;">SKILL MASTERY</p>

        <a href="javascript:void(0);" onclick="exitAndGoHome()" class="nav-btn">BACK TO MENU</a>
    </aside>

    <main class="content-section">
        <h2 style="margin-bottom: 35px; text-transform: uppercase; font-weight: 900; letter-spacing: 2px;">Technical & Creative Skill Tree</h2>

        <!-- Architect Path -->
        <div class="skill-category">
            <div class="skill-header">The Architect Path (Technical)</div>
            <div class="skill-grid">
                <div class="skill-box">
                    <h5>Programming</h5>
                    <p>Proficient in ASP.NET MVC 5, C# Logic, Razor Pages, and Bootstrap 5.</p>
                </div>
                <div class="skill-box">
                    <h5>Hardware Services</h5>
                    <p>Troubleshooting, PC building, and preventative maintenance.</p>
                </div>
                <div class="skill-box">
                    <h5>Computer Literacy</h5>
                    <p>OS management, productivity suites, and system optimization.</p>
                </div>
            </div>
        </div>

        <!-- Artisan Path -->
        <div class="skill-category" style="border-left-color: #b21f1f;">
            <div class="skill-header" style="color: #ff4e50;">The Artisan Path (Creative)</div>
            <div class="skill-grid" style="grid-template-columns: repeat(2, 1fr);">
                <div class="skill-box" style="border-left: 1px solid rgba(255,255,255,0.1);">
                    <h5>Fine Arts</h5>
                    <p>Traditional drawing and study of Shan Sui landscape techniques.</p>
                </div>
                <div class="skill-box" style="border-left: 1px solid rgba(255,255,255,0.1);">
                    <h5>UI/UX Design</h5>
                    <p>Gaming-themed interfaces and e-sports apparel concepts.</p>
                </div>
            </div>
        </div>

        <!-- Provisioner Path -->
        <div class="skill-category" style="border-left-color: #1a2a6c;">
            <div class="skill-header" style="color: #00d2ff;">The Provisioner Path (Life)</div>
            <div class="skill-grid" style="grid-template-columns: 1fr;">
                <div class="skill-box">
                    <h5>Culinary Arts</h5>
                    <p>Skilled in home cooking and recipe experimentation.</p>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    function exitAndGoHome() {
        const img = document.getElementById('profileImage');
        if (img) { img.classList.add('rolling-out'); }
        setTimeout(function() {
            window.location.href = '@Url.Action("Macadat241678Index", "Macadat241678Home")';
        }, 750);
    }
</script>