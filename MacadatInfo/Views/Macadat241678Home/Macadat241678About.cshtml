@{
    ViewBag.Title = "About Me - Macadat241678";
}

<style>
    /* 3. CYBER HUD GRID OVERLAY */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: 
            linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 30px 30px;
        pointer-events: none;
        z-index: -1;
    }

    body {
        background-color: #2c3e50 !important; /* Stone Gray Base */
        margin: 0;
        min-height: 100vh;
        overflow: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* MAIN LAYOUT */
    .about-wrapper {
        display: flex;
        min-height: 85vh;
        margin: 30px auto;
        width: 95%;
        background: rgba(13, 27, 42, 0.8) !important; /* Glass effect base */
        backdrop-filter: blur(15px);
        border-radius: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: hidden;
    }

    /* SIDEBAR - Matching the Index Gradient */
    .sidebar {
        flex: 0 0 240px;
        background: linear-gradient( to right, #1F1C2C,#928DAB );
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* PROFILE IMAGE WITH UPDATED ROLLING ANIMATION */
    .profile-roll {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 4px solid #ffffff;
        object-fit: cover;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        animation: rollIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .profile-roll.exit-active {
        animation: rollOut 0.7s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards !important;
    }

    @@keyframes rollIn {
        0% { 
            width: 180px; 
            height: 180px; 
            transform: translate(350px, 180px) rotate(-360deg); 
            opacity: 0; 
        }
        100% { 
            width: 80px; 
            height: 80px; 
            transform: translate(0, 0) rotate(0deg); 
            opacity: 1; 
        }
    }

    @@keyframes rollOut {
        0% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
        100% { 
            transform: translate(350px, 180px) rotate(360deg); 
            opacity: 0; 
            width: 180px; 
            height: 180px; 
        }
    }

    /* NEON GLASS CONTENT SECTION */
    .content-section {
        flex: 1;
        padding: 60px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0d1b2a !important;
    }

    .glass-module {
        width: 100%;
        max-width: 700px;
        background: rgba(255, 255, 255, 0.03) !important;
        padding: 45px;
        border-radius: 25px;
        border: 1px solid rgba(0, 210, 255, 0.2) !important;
        color: white;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        animation: slideUp 0.8s ease-out;
    }

    .glass-module.exit-active {
        animation: slideDown 0.5s ease-in forwards;
    }

    @@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @@keyframes slideDown { from { transform: translateY(0); opacity: 1; } to { transform: translateY(30px); opacity: 0; } }

    /* HUD-Style Data Table */
    .data-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .data-label { color: #00d2ff; font-weight: bold; text-transform: uppercase; font-size: 0.8rem; }
    .data-value { color: white; font-weight: 600; }

    /* Navigation Button */
    .nav-btn {
        margin-top: 30px;
        padding: 12px 25px;
        background: rgba(0, 0, 0, 0.5);
        color: white;
        text-decoration: none !important;
        border-radius: 50px;
        font-weight: bold;
        transition: 0.3s;
        border: 1px solid rgba(255,255,255,0.2);
        cursor: pointer;
    }
    .nav-btn:hover { background: white; color: black; transform: scale(1.05); }
</style>/

<div class="about-wrapper">
    <aside class="sidebar">
        <img id="profileImage" 
             src="~/Content/Image/Portrait.kinjihakari.png" 
             class="profile-roll" 
             alt="Macadat" />

        <h4 style="color:white; margin-top:20px; font-weight: 800; letter-spacing: 1px;">MACADAT, KARLITO</h4>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.75rem; letter-spacing: 2px;">DEVELOPER // SBIT-2D</p>
        
        <a href="javascript:void(0);" onclick="goBack()" class="nav-btn">BACK TO MENU</a>
    </aside>

    <main class="content-section">
        <div id="contentCard" class="glass-module">
            <h2 style="color:#f9d423; text-transform:uppercase; letter-spacing:3px; margin-bottom: 20px;">Personal Intel</h2>
            
            <p style="line-height: 1.8; font-size: 1.05rem; margin-bottom: 30px; opacity: 0.9;">
                Currently enrolled in the BSIT program at <span style="color:#00d2ff; font-weight: bold;">Quezon City University (QCU)</span>. 
                My development journey focuses on building high-performance web applications using <span style="color:#f9d423;">ASP.NET MVC</span> 
                and crafting immersive UI/UX experiences inspired by gaming culture.
            </p>

            <div class="data-grid">
                <div class="data-row"><span class="data-label">Student ID</span><span class="data-value">24-1678</span></div>
                <div class="data-row"><span class="data-label">Program</span><span class="data-value">BS in Information Technology</span></div>
                <div class="data-row"><span class="data-label">Specialization</span><span class="data-value">Web Systems & UI/UX</span></div>
            </div>
        </div>
    </main>
</div>

<script>
    function goBack() {
        document.getElementById('profileImage').classList.add('exit-active');
        document.getElementById('contentCard').classList.add('exit-active');

        setTimeout(function() {
            window.location.href = '@Url.Action("Macadat241678Index", "Macadat241678Home")';
        }, 700); 
    }
</script>