@{
    ViewBag.Title = "Portfolio - Macadat241678";
}

<style>
    /* CYBER HUD GRID OVERLAY */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 30px 30px;
        pointer-events: none;
        z-index: -1;
    }

    body {
        background-color: #2c3e50 !important; /* Stone Gray Base */
        margin: 0;
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .portfolio-wrapper {
        display: flex;
        min-height: 85vh;
        margin: 30px auto;
        width: 95%;
        background: rgba(13, 27, 42, 0.9) !important;
        border-radius: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* SIDEBAR - Purple-Grey Gradient */
    .sidebar {
        flex: 0 0 220px;
        background: linear-gradient(to right, #1F1C2C, #928DAB);
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .profile-roll {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 3px solid #fdbb2d;
        object-fit: cover;
        animation: rollIn 1.0s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

        .profile-roll.exit-active {
            animation: rollOut 0.8s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards !important;
        }

    @@keyframes rollIn {
        0% {
            width: 180px;
            height: 180px;
            transform: translate(80px, 180px) rotate(-180deg);
            opacity: 0;
        }

        100% {
            width: 60px;
            height: 60px;
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }
    }

    @@keyframes rollOut {
        0% {
            width: 60px;
            height: 60px;
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }

        100% {
            width: 180px;
            height: 180px;
            transform: translate(80px, 180px) rotate(180deg);
            opacity: 0;
        }
    }

    /* PROJECT GRID STYLING */
    .content-section {
        flex: 1;
        padding: 50px;
        background: #0d1b2a;
    }

    .project-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .project-card {
        background: rgba(255, 255, 255, 0.03);
        padding: 30px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: 0.4s;
    }

        .project-card:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: #00d2ff;
            transform: translateY(-5px);
        }

    .category-label {
        font-size: 0.7rem;
        color: #fdbb2d;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 800;
        margin-bottom: 10px;
        display: block;
    }

    .project-title {
        color: white;
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .project-desc {
        color: #bdc3c7;
        font-size: 0.85rem;
        line-height: 1.6;
        margin-bottom: 20px;
        min-height: 50px;
    }

    .tech-stack {
        color: #00d2ff;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .nav-btn {
        margin-top: 25px;
        padding: 12px 25px;
        background: rgba(255,255,255,0.1);
        color: #fdbb2d;
        border-radius: 12px;
        text-decoration: none !important;
        font-weight: bold;
        display: inline-block;
        border: 1px solid rgba(255,255,255,0.1);
        cursor: pointer;
    }

        .nav-btn:hover {
            background: white;
            color: black;
        }
</style>

<div class="portfolio-wrapper">
    <aside class="sidebar">
        <img id="profileImage" src="~/Content/Image/Portrait.kinjihakari.png" class="profile-roll" alt="Macadat" />
        <h4 style="color:white; margin-top:20px; text-align:center; font-weight: 700;">Macadat, Karlito R.</h4>
        <p style="color: rgba(255,255,255,0.6); font-size: 0.7rem; letter-spacing: 1px;">ARCHIVE ACCESS</p>

        <a href="javascript:void(0);" onclick="goBack()" class="nav-btn">BACK TO MENU</a>
    </aside>

    <main class="content-section">
        <h2 style="color:white; margin-bottom: 40px; text-transform: uppercase; letter-spacing: 3px; font-weight: 900;">Project Archive</h2>

        <div class="project-grid">
            <!-- Project 1: Updated to Input Output Project -->
            <div class="project-card">
                <span class="category-label">Fundamental Programming</span>
                <div class="project-title">Basic I/O & Variables</div>
                <p class="project-desc">A web-based compilation featuring 5 unique samples of basic input, output, and variable management.</p>
                <div class="tech-stack">C# • ASP.NET MVC • Razor Pages</div>
            </div>

            <!-- Project 2 -->
            <div class="project-card">
                <span class="category-label">Membership System</span>
                <div class="project-title">Olympia Gym</div>
                <p class="project-desc">A membership management system featuring registration, workout goal selection, and payment simulations.</p>
                <div class="tech-stack">C# • Razor Pages • JavaScript</div>
            </div>

            <!-- Project 3 -->
            <div class="project-card">
                <span class="category-label">Admin Management</span>
                <div class="project-title">Hero Registry</div>
                <p class="project-desc">An administrative system for managing and searching a digital archive of fictional hero profiles.</p>
                <div class="tech-stack">MVC Pattern • CRUD Operations</div>
            </div>

            <!-- Project 4 -->
            <div class="project-card">
                <span class="category-label">Academic Compilation</span>
                <div class="project-title">Prog Compilation</div>
                <p class="project-desc">A web repository containing various programming samples covering logic, conditionals, and loops.</p>
                <div class="tech-stack">HTML5 • CSS3 • C# Samples</div>
            </div>
        </div>
    </main>
</div>

<script>
    function goBack() {
        document.getElementById('profileImage').classList.add('exit-active');
        setTimeout(function() {
            window.location.href = '@Url.Action("Macadat241678Index", "Macadat241678Home")';
        }, 750);
    }
</script>